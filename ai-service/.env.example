# LLM Provider configuration (Session 2 — kept for backwards compatibility)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai

# Default model for the configured provider. Can be overridden per request via
# the "model" field in POST /api/v1/estimate (handy for live A/B comparisons
# without restarting the server).
LLM_MODEL=gpt-4o-mini

# Application
APP_ENV=development
LOG_LEVEL=DEBUG

# --- Session 3 — LiteLLM wrapper ----------------------------------------------
# The wrapper tries PRIMARY_MODEL first and falls back to FALLBACK_MODEL on
# failure, with up to LLM_RETRIES attempts and an LLM_TIMEOUT-second deadline.
PRIMARY_MODEL=gpt-4o-mini
FALLBACK_MODEL=claude-haiku-4-5-20251001
LLM_TIMEOUT=600
LLM_RETRIES=2

# --- Session 3 — Redis exact-match cache --------------------------------------
# Inside docker-compose, REDIS_URL is overridden to redis://redis:6379.
# When running uvicorn locally (outside Docker), use redis://localhost:6379.
REDIS_URL=redis://redis:6379
CACHE_TTL=86400

# --- Session 3 — Streamlit transport ------------------------------------------
# Streamlit hits the FastAPI service over HTTP. Point this to wherever the
# estimator is reachable from the machine running streamlit_app.py.
ESTIMATOR_API_BASE_URL=http://localhost:8000

# --- Session 4 — Semantic cache (redisvl + embeddings) ------------------------
# Cosine similarity threshold (0..1) above which a stored estimation is served
# as a cache hit. 0.92 is conservative; lower threshold = more recall, more
# false positives. Affines with the chosen embedding model.
EMBEDDING_MODEL=text-embedding-3-small
SEMANTIC_CACHE_THRESHOLD=0.85
SEMANTIC_CACHE_TTL=86400
# When true, the cache logs would-be hits but does NOT serve them — useful to
# calibrate the threshold against production traffic before flipping on.
SEMANTIC_CACHE_LOG_ONLY=false

# --- Session 6 — Postgres + Ingestion -----------------------------------------
# Postgres (image: pgvector/pgvector:pg16). In Session 6 we use it for the
# pseudonymization mapping table and ingestion job tracking only. The pgvector
# extension is NOT activated yet (no ``CREATE EXTENSION vector``); Session 7
# will add a migration that turns it on.
# Inside docker-compose, DATABASE_URL is overridden to postgres:5432. When
# running uvicorn locally (outside Docker), use localhost:5433 (host-mapped).
DATABASE_URL=postgresql+psycopg://estimator:estimator@vector-db:5432/estimator

# Path to the data-source catalog (YAML). Loaded once at startup, validated
# with Pydantic. ``include`` decisions drive the ingestion endpoint.
CATALOG_PATH=data/catalog/catalog.yaml

# Root folder where the catalog ``location`` entries are resolved against.
INGESTION_DATA_ROOT=data/seed

# spaCy model that Presidio uses to detect PERSON/LOC entities. Without an
# explicit Spanish model, Presidio defaults to English and SILENTLY misses
# Hispanic names — a teaching moment in the live session.
PRESIDIO_SPACY_MODEL=es_core_news_md

# Faker locale for generating pseudonyms (names, emails, …).
PSEUDONYM_FAKER_LOCALE=es_ES

# HMAC salt used to derive the ``original_hash`` stored in pseudonym_mappings.
# Rotating this salt invalidates all prior mappings — that is the lever for
# GDPR Art. 17 'right to be forgotten' at the corpus level. CHANGE IN PROD.
PSEUDONYM_HASH_SALT=change-me-in-prod

# --- Session 9 — RAG estimation (transcript → grounded estimate) --------------
# Two independent API keys protect the two new routers. Sent by clients in the
# X-API-Key header. These DEMO values MUST MATCH business-backend/.env so the RAG
# wizard authenticates; leave blank to disable a router (every request → 401).
RETRIEVAL_API_KEY=demo-retrieval-key
ESTIMATE_API_KEY=demo-estimate-key

# Models for the RAG pipeline (both go through LLMWrapper / Instructor). The
# reformulator distills the transcript; the generator reasons over retrieved
# budgets with medium reasoning effort. Switchable at runtime via the Ajustes UI.
REFORMULATION_MODEL=gpt-5-mini
GENERATION_MODEL=gpt-5
# "high" drives a deeper module→task decomposition (granular modular breakdown).
# The S09 article used "medium"; lower it back if you want the article's value.
GENERATION_REASONING_EFFORT=high
# Token ceiling (reasoning + output) for the RAG structured calls. gpt-5 spends
# reasoning tokens against this budget, so the 4000 wrapper default truncates
# the JSON (finish_reason='length' → 502). 64000 leaves room for high-effort
# reasoning + the larger nested (modules→tasks) output. A cap, not a target —
# costs nothing extra unless the model uses it. Changing it needs a recreate.
GENERATION_MAX_TOKENS=64000

# Retrieval knobs (locked defaults).
RETRIEVAL_TOP_K=10
RETRIEVAL_DISTANCE_THRESHOLD=0.6

# Token budget for the assembled <source> context block (tiktoken cl100k_base).
MAX_CONTEXT_TOKENS=16384

# Idempotency cache TTL (seconds) for POST /v1/estimate/from-transcript. Uses
# REDIS_URL when set; otherwise an in-process dict fallback.
IDEMPOTENCY_TTL=86400

# --- Session 10 — hybrid search + cross-encoder reranking ---------------------
# Defaults for the retrieval mode and reranking. Both are overridable per request
# (search_mode / rerank in the /v1/retrieval/search payload) and at runtime via
# PUT /api/v1/config/retrieval (Ajustes UI) — no restart needed to flip them.
# "vector" + off = the Session 9 baseline (config A in the measurement).
RETRIEVAL_SEARCH_MODE=vector
RERANKER_ENABLED=false
# Multilingual cross-encoder. First use downloads the weights (~450MB) from the
# HuggingFace hub; verify with `python -m app.generation.rag.retrieval.verify_reranker`.
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Recall-then-rerank widths: recall this many candidates, rerank down to top-N.
RETRIEVAL_RECALL_TOP_K=50
RERANK_TOP_N=5
# RRF smoothing constant for fusing the vector + lexical rankings.
RRF_K=60

# Per-task hours search: how many historical analogs feed the consensus and how far
# a neighbour may be (cosine distance, lower = closer) before a task is left with no
# hours and flagged red in the UI. Both are also runtime-switchable via
# PUT /api/v1/config/retrieval (Ajustes UI) — including on the graph path, where
# fan_out_hours resolves them once and passes them down each Send.
# The right value depends on the CORPUS: the wider the catalog of distinct historical
# task templates, the tighter this can be. Measure, do not guess —
# scripts/measure_task_hours_coverage.py sweeps it against a frozen structure.
TASK_HOURS_TOP_K=5
TASK_HOURS_DISTANCE_THRESHOLD=0.45

# The SECOND distance cut: the one the agentic hours-recovery join searches with.
# Easy to confuse with the one above, and they do different jobs. The fan-out cut
# decides which tasks come back with no hours and are handed to the recovery agent;
# THIS one decides which of those the agent can rescue, and therefore how many tasks
# finally end up flagged for a human. A value much looser than the fan-out's means
# nothing is ever left unmatched once the corpus is large. Also runtime-switchable via
# PUT /api/v1/config/retrieval, so it can be calibrated at the human gate.
AGENT_SEARCH_DISTANCE_THRESHOLD=0.6
AGENT_SEARCH_TOP_K=5

# --- Session 13 — LangGraph estimation graph + Logfire observability ----------
# The estimation flow re-expressed as a StateGraph (app/domain/graph). Its
# structured-output nodes go through LLMWrapper. Both are in AVAILABLE_MODELS
# (switchable in the Ajustes tab). Consolidation must reliably fill numeric fields;
# gpt-4o-mini tends to leave them null, so the estimate node defaults to gpt-4o.
GRAPH_EXTRACTION_MODEL=gpt-4o-mini
GRAPH_GENERATION_MODEL=gpt-4o
# The graph's Postgres checkpointer reuses DATABASE_URL (its tables coexist with
# pgvector) — no separate connection string.
#
# Observability: set LOGFIRE_TOKEN to export one span per node to Pydantic Logfire
# (get a write token at https://logfire.pydantic.dev). With no token every span
# still runs locally but nothing is exported, so the service works either way.
# LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=estimator

# Jev (TypeSafe AI) triage in recover_and_handover (ON by default): doubtful tasks that have
# hours are classified by Jev (accept as is / escalate to the gpt-5 recovery agent)
# before Trinity runs. A blank key leaves it inert (pre-Jev behaviour). Key from
# https://www.jevai.org/agent/keys. Any Jev failure escalates (pre-Jev behaviour).
GRAPH_JEV_ENABLED=true
# JEV_API_KEY=
JEV_API_BASE_URL=https://www.jevai.org
JEV_MODEL=typesafe-ai/jev
JEV_TIMEOUT=10
JEV_MAX_CONCURRENCY=8
GRAPH_JEV_MIN_RELIABILITY=0.15
GRAPH_JEV_ACCEPT_CONFIDENCE=0.7
# Flat price per Jev call (USD) for the token/cost comparison; unpublished → 0.
JEV_COST_PER_CALL_USD=0.0

# --- Session 14 — supervisor multi-agent flow + human-in-the-loop -------------
# The estimation flow reorganised as a hand-built supervisor that routes at RUNTIME
# to four least-privilege agents (app/domain/graph/supervisor). It coexists with the
# Session 13 graph and shares its Postgres checkpointer; the router namespaces thread
# ids as "s14:<estimation_id>" so the two flows never collide on one thread.
#
# The router is LLM-driven but the decision space is five Literal options over a short
# factual digest, so a cheap non-reasoning model is the right tool.
SUPERVISOR_ROUTER_MODEL=gpt-4o-mini
# Hard ceiling on routing steps — the brake that makes an LLM router safe in a graph
# with cyclic return edges (four agents plus room for one re-route, then finish).
SUPERVISOR_MAX_STEPS=8
# Human-review trigger 1: pause below this 0..1 confidence. THE knob of the session —
# raise it to send more estimates to a person.
SUPERVISOR_CONFIDENCE_THRESHOLD=0.6
# Human-review trigger 3: pause when fewer than this fraction of components have any
# precedent at all in the historical budgets.
SUPERVISOR_MIN_GROUNDED_RATIO=0.5
# Level 3: false = a denied tool call returns an envelope the agent survives (the run
# completes and the denial is visible in the trace); true = it raises and fails loudly.
SUPERVISOR_PRIVILEGE_STRICT=false
# How much of a tool call's arguments the audit log echoes. The SHA-256 digest is
# always logged in full, so identity is provable without dumping a transcript.
SUPERVISOR_AUDIT_ARGS_PREVIEW_CHARS=200

# --- Session 15: service-to-service authentication ---------------------------
# Shared secret between the business backend and this service, carried in the
# X-Service-Token header and enforced as MIDDLEWARE (app/api/service_token.py)
# on every route except /health, /docs, /redoc and /openapi.json.
#
# This is the OUTER layer ("are you a service allowed to talk to me at all?").
# RETRIEVAL_API_KEY / ESTIMATE_API_KEY above stay the inner layer ("which
# endpoints may you use?"). Sending the token does NOT open the keyed routers.
#
# LEAVE IT BLANK HERE. Two reasons:
#   1. Blank disables the middleware, which is what you want when running
#      uvicorn locally — the opposite of the S9 keys, where blank means 401.
#   2. pydantic reads this file when you run pytest from ai-service/, so a value
#      here would switch the guard on mid-suite. (tests/conftest.py has an
#      autouse fixture that neutralises it, but do not rely on that.)
#
# The value that matters lives in the ROOT .env, which is what docker compose
# injects into both containers. Generate one with: openssl rand -hex 32
AI_SERVICE_TOKEN=

# Set to false to boot the container without applying Alembic migrations
# (docker-entrypoint.sh). Useful when several replicas start at once and only
# one of them should migrate.
RUN_MIGRATIONS=true
